# --- Database (MySQL). URL-encode special characters in the password (e.g. @ -> %40) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ecommerce_poc"
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

# --- Razorpay TEST mode (https://dashboard.razorpay.com -> Test Mode -> API Keys / Webhooks) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_key_secret"
# Required: webhook requests are rejected (503) when this is empty.
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"

# --- UCP (all optional) ---
# Public https base URL advertised in /.well-known/ucp (e.g. an ngrok URL). Default http://localhost:PORT
# UCP_PUBLIC_BASE_URL="https://your-tunnel.example"
# Registry of platforms allowed to call /ucp/v1 (created by `npm run ucp:setup`). Default ./ucp-platforms.json
# UCP_PLATFORMS_FILE="./ucp-platforms.json"
# Requests per minute per IP on /ucp/v1. Default 120
# UCP_RATE_LIMIT_PER_MIN=120
# Legal links returned in every checkout (default FRONTEND_URL/terms and /privacy)
# UCP_TERMS_URL="https://shop.example/terms"
# UCP_PRIVACY_URL="https://shop.example/privacy"

# --- Gemini AI shopping assistant (website chatbot). Server-side only; never expose to the browser ---
GEMINI_API_KEY="your_gemini_api_key"
# GEMINI_MODEL="gemini-3.5-flash"
# --- The chatbot calls /ucp/v1 as a registered platform (created by `npm run ucp:register-chat`) ---
# CHAT_UCP_BASE_URL="http://127.0.0.1:5000"        # default: loopback to this server
# CHAT_UCP_PROFILE / CHAT_UCP_API_KEY / CHAT_UCP_PRIVATE_JWK   # default: .ucp-test-platform/chat-credentials.json
# CHAT_RATE_LIMIT_PER_MIN=60                         # per IP on /api/chat
