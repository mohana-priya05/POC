{
  "name": "ecommerce-poc-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest --runInBand",
    "ucp:setup": "ts-node --transpile-only scripts/ucp-setup.ts",
    "ucp:register-chat": "ts-node --transpile-only scripts/ucp-register-chat.ts",
    "test:chat": "jest --runInBand tests/chat.test.ts",
    "ucp:call": "ts-node --transpile-only scripts/ucp-call.ts",
    "ucp:demo": "ts-node --transpile-only scripts/ucp-demo.ts",
    "test:ucp": "jest --runInBand tests/ucp.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "morgan": "^1.10.0",
    "raw-body": "^2.5.2",
    "razorpay": "^2.9.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
